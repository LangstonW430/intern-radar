# intern-radar environment variables, grouped by WHERE each one is set.
# .env.local is NOT meant to mirror this file — most variables below are
# read by Convex functions and live on the Convex deployment
# (`npx convex env set NAME value`), not in .env.local.

# ============================================================
# 1. .env.local (gitignored) — read by the Next.js app and the
#    local scripts (seed:profile, label export/import).
#    `npx convex dev` writes the first three automatically.
# ============================================================
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Turnstile site key — public by design; also set this in Vercel's env.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFKkUyT0DPs4DoBC
# For the local scripts only: must match the Convex deployment's values.
ML_SHARED_SECRET=
CONVEX_SITE_URL=

# ============================================================
# 2. Convex deployment env vars (`npx convex env set NAME value`)
#    — read by Convex functions; never put real values in the repo.
# ============================================================
# Source repo for listings, owner/repo form. Switching seasons is one change.
SOURCE_REPO=SimplifyJobs/Summer2027-Internships
# Optional: raises GitHub API rate limits for the SHA check (fine-grained, public repo read-only).
GITHUB_TOKEN=
# Resend; DIGEST_FROM_EMAIL must be on a verified Resend domain.
RESEND_API_KEY=
DIGEST_FROM_EMAIL=
# Open sign-up: anyone can create an account. Comma-separated emails with
# access to /admin surfaces only.
ADMIN_EMAILS=
# Cloudflare Turnstile secret — lives in the Cloudflare dashboard. When
# unset (local dev), the captcha check is skipped; rate limits still apply.
TURNSTILE_SECRET_KEY=
# Shared secret between the GitHub Actions job and the export/import endpoints.
ML_SHARED_SECRET=
# Signs expiring feedback/unsubscribe links in digest emails.
FEEDBACK_SIGNING_SECRET=
# Fine-grained PAT used by Convex to fire repository_dispatch when a resume/profile changes.
GITHUB_DISPATCH_TOKEN=
# Public URL of the deployed app; digest links point here and Turnstile
# tokens are checked against this hostname.
APP_URL=
# Required by Convex Auth (same value as APP_URL).
SITE_URL=
# Fixed post-model multiplier for listings without a job description. Never learned.
NO_JD_PENALTY=0.6

# ============================================================
# 3. GitHub Actions secrets (repo Settings → Secrets) — used by
#    .github/workflows/ml.yml. Same values as the Convex deployment's.
# ============================================================
# CONVEX_SITE_URL — the deployment's .convex.site URL
# ML_SHARED_SECRET — must match the Convex deployment's value
