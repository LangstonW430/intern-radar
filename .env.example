# --- Convex deployment (set by `npx convex dev` / Vercel integration) ---
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=

# --- Ingest ---
# Source repo for listings, owner/repo form. Switching seasons is one change.
SOURCE_REPO=SimplifyJobs/Summer2027-Internships
# Optional: raises GitHub API rate limits for the SHA check (fine-grained, public repo read-only).
GITHUB_TOKEN=

# --- Email ---
RESEND_API_KEY=
# Must be on a verified Resend domain.
DIGEST_FROM_EMAIL=

# --- Access control ---
# Open sign-up: anyone can create an account. Comma-separated emails with
# access to /admin surfaces only.
ADMIN_EMAILS=

# --- Abuse protection ---
# Cloudflare Turnstile. When TURNSTILE_SECRET_KEY is unset (local dev), the
# captcha check is skipped; rate limits still apply. The secret key lives in
# the Cloudflare dashboard — set it on the Convex deployment, never here.
# The site key is public by design.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFKkUyT0DPs4DoBC

# --- ML job auth ---
# Shared secret between the GitHub Actions job and the Convex export/import endpoints.
ML_SHARED_SECRET=
# Signs expiring feedback links in digest emails.
FEEDBACK_SIGNING_SECRET=
# Fine-grained PAT used by Convex to fire repository_dispatch when a resume/profile changes.
GITHUB_DISPATCH_TOKEN=

# --- App ---
# Public URL of the deployed app; digest links point here.
APP_URL=

# --- Scoring ---
# Fixed post-model multiplier for listings without a job description. Never learned.
NO_JD_PENALTY=0.6
